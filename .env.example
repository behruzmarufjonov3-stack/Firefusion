# FireFusion Environment Configuration (Optional)
# Platform runs 100% client-side with precomputed verified NASA FIRMS datasets.
# No secrets or keys are required for default operation.

VITE_APP_TITLE=FireFusion
VITE_ENABLE_SIMULATION=true

# NASA FIRMS MAP_KEY (Optional - for custom live archive queries)
VITE_FIRMS_MAP_KEY=

# Meteomatics Weather API (Optional - for live on-demand meteorological queries)
# Leave blank to use verified offline station telemetry.
# NEVER commit your actual credentials to Git or public repositories.
VITE_METEOMATICS_USER=
VITE_METEOMATICS_PASSWORD=
